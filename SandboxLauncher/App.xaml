<Application
    x:Class="SandboxLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FA"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#171A20"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#222731"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A3ACBA"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#6EA8FE"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
